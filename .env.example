# =============================================================
# DiyaPulse A2A — Diwali Festiverse A2A Hackathon (SF 2026)
# Copy this file to .env.local and fill in your API keys.
# All 5 sponsors also support graceful demo fallback if omitted.
# =============================================================

# 1. BAND (https://app.band.ai) — Shared A2A Room & Collaboration Bus
# User key (Full access): Settings -> REST API Keys -> Create New API Key
BAND_USER_API_KEY=
# Agent keys: Agents -> Create "Data Agent" & "Builder Agent"
BAND_DATA_AGENT_API_KEY=
BAND_BUILDER_AGENT_API_KEY=
# Optional: override Band API base URL (default: https://api.band.ai)
BAND_API_BASE=https://api.band.ai

# 2. LYZR (https://studio.lyzr.ai) — Data Agent Synthesis Engine
LYZR_API_KEY=
LYZR_DATA_AGENT_ID=
LYZR_USER_ID=

# 3. AGENT37 (https://www.agent37.com) — Cloud Sandbox & Live Public Preview URL
AGENT37_API_KEY=
# Optional: reuse an existing running instance ID for faster publishes
AGENT37_INSTANCE_ID=

# 4. GEMINI / OPENAI — LLM for Data structuring & AdaL Builder Agent codegen
# Free tier available at https://aistudio.google.com/apikey
GEMINI_API_KEY=
OPENAI_API_KEY=

# 5. FINCH (https://www.finchtech.ai) — Reusable Agent Skills & MCP
FINCH_MCP_URL=https://www.finchtech.ai/mcp
FINCH_A2A_TOKEN=

# 6. Optional: GitHub Personal Access Token (raises live GitHub API rate limit)
GITHUB_TOKEN=
